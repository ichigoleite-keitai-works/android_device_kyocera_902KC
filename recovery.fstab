#device         mount point      fstype        [device2] [length=]
/dev/block/bootdevice/by-name/system                     /system              ext4                                       flags=display="System";backup=1;                            wait
/dev/block/bootdevice/by-name/system                     /system_image        emmc                                       flags=display="System image";backup=1;flashimg=1;           wait
/dev/block/bootdevice/by-name/vendor                     /vendor              ext4                                       flags=display="Vendor";backup=1;                            wait
/dev/block/bootdevice/by-name/vendor                     /vendor_image        emmc                                       flags=display="Vendor image";backup=1;flashimg=1;           wait
/dev/block/bootdevice/by-name/cache                      /cache               ext4                                       flags=display="Cache";                                      wait,check
/dev/block/bootdevice/by-name/userdata                   /data                f2fs                                       flags=display="Data";                                       wait,check
/dev/block/bootdevice/by-name/boot                       /boot                emmc                                       flags=display="Boot";backup=1;flashimg=1;                   defaults
/dev/block/bootdevice/by-name/recovery                   /recovery            emmc                                       flags=display="Recovery";backup=1;flashimg=1;               defaults
/dev/block/bootdevice/by-name/misc                       /misc                emmc                                       flags=display="Misc";backup=1;flashimg=1;                   defaults